3],[-1052,575],[772,878],[1066,260],[647,-269],[1046,634],[-282,810],[36,1124],[314,176],[66,1905],[842,1112],[-992,311],[-2274,380],[-458,689],[-1018,574],[-1286,253],[-932,1136],[996,621],[892,-325],[1052,17],[557,-228],[1473,-1143],[588,1920],[-1186,567],[620,1229],[-840,-276],[-340,499],[-1202,235],[477,441],[62,649],[-1662,264],[-446,-1285],[-1101,-364],[-582,358],[-873,54],[-544,1151],[781,439],[-298,894],[1093,899],[-1255,840],[1117,281],[520,1383],[-542,649],[-792,312],[322,1323],[-939,1251],[-167,751],[-1076,1618],[-17,869],[608,197],[-1040,902],[52,420],[-2103,1253],[-863,1135],[806,519],[-639,648],[-792,199],[-377,754],[-1393,640],[-1158,8],[-66,525],[-2494,364],[-1766,558],[-402,-811],[-1076,320],[-1592,-985],[-1732,250],[-1036,763],[-427,-434],[1343,-914],[-3182,557],[-1970,1281],[912,494]],[[6059,69913],[859,-841],[603,0],[325,1265]],[[7846,70337],[-4372,848],[-1121,801],[723,841],[3012,278],[1132,505],[2611,-87],[1177,579],[-916,760],[-863,-6],[-737,-624],[-2667,-302],[-1689,441],[-1730,896],[-2406,1425],[317,1744],[1694,515],[3461,698],[661,722],[1626,408],[2226,285],[919,-175],[2056,1708],[-440,1444],[332,938],[-3474,-48],[-663,1186],[1140,885],[2672,959],[607,913],[1347,256],[1558,723],[1842,-421]],[[35261,42137],[909,-358],[-497,-463],[33,-676],[-481,-89],[-156,864],[192,722]],[[32514,39737],[-1119,-448],[-918,417],[572,373],[-134,569],[-1401,117],[-417,477],[369,1128],[-102,976],[615,474],[899,-97],[1043,-371],[879,-1154],[1194,-521],[265,-731],[-499,-652],[-1246,-557]],[[30889,47064],[-94,372],[560,637],[361,-704],[-827,-305]],[[33198,47831],[-289,-405],[-749,188],[242,735],[796,-518]],[[6059,69913],[567,362],[1220,62]],[[36079,22188],[-356,-232],[178,-600]],[[33952,19699],[-216,358],[453,667],[-653,1020],[130,868],[-121,683],[-849,372],[59,580],[-711,12],[195,570],[-628,634],[166,639],[-558,1040],[438,1209],[1242,201],[-700,1007],[-902,-86],[-519,814],[260,1325],[698,479],[542,690],[1044,310],[891,-563],[998,64],[1104,-711],[777,98]],[[48463,11963],[1255,-793],[212,-566],[-22,-805],[-247,-985],[493,-26],[-671,-1995],[44,-725],[-339,-295],[57,-1125],[-347,-758],[96,-987],[-612,-245],[-188,-488],[369,-754],[-79,-751],[-1394,465],[-803,-284],[-178,-567],[-629,213],[-347,729],[426,483],[-764,798],[-961,270],[425,668],[-456,271],[-53,468],[-561,720],[-419,-388],[-377,-812],[-317,256],[-625,-141],[-807,61],[77,706]],[[48429,636],[-505,-89],[-179,-547],[-507,292],[-283,776],[1474,-432]]],"bbox":[-72.784291,59.923041,-11.638579999999997,83.634101],"transform":{"scale":[0.0006114632246322463,0.00023711297112971133],"translate":[-72.784291,59.923041]}},"regions":[{"k":0,"name":"Sermersooq","type":"Region","area":544237,"lab":[68.68,-38.21],"cap":"Nuuk","pop":24643,"title":"Sermersooq","text":["Sermersooq (Greenlandic pronunciation: [sɜm.mɜs.sɔːq̚]) is a municipality in Greenland, formed on 1 January 2009 from five previous, smaller municipalities, and is the largest municipality in the world by area. Its administrative seat is the city of Nuuk, the capital of Greenland, and it is the most populous municipality in the country, with 24,229 inhabitants as of January 2025."]},{"k":1,"name":"Northeast Greenland National Park","type":"Region","area":873438,"lab":[79.34,-33.26],"cap":null,"pop":100,"title":"Northeast Greenland National Park","text":["Northeast Greenland National Park (Greenlandic: Kalaallit Nunaanni nuna eqqissisimatitaq, Danish: Nordøstgrønlands Nationalpark) is the world's largest national park and the 10th largest protected area (the only larger protected areas consist mostly of sea). Established in 1974, the Northeast Greenland national park expanded to its present size in 1988. It protects 972,000 km2 (375,000 mi2) of the interior and northeastern coast of Greenland and is larger than the area of Tanzania, but smaller than that of Egypt. This means that the national park is bigger than 166 of the world's 195 countries. It was the first national park to be created in the Kingdom of Denmark and remains Greenland's only national park. It is the northernmost national park in the world."]},{"k":2,"name":"Qaasuitsup","type":"Region","area":577096,"lab":[76.74,-51.79],"cap":"Ilulissat","pop":17498,"title":"Qaasuitsup","text":["Qaasuitsup (Greenlandic pronunciation: [qaːsuitt͡sup̚], Place of Polar Darkness) was a municipality in Greenland, operational from 1 January 2009 to 31 December 2017. As of January 2015, its population was 17,168. The administrative centre of the municipality was in Ilulissat (Jacobshavn)."]},{"k":3,"name":"Pituffik","type":"Region","area":636,"lab":[76.48,-68.5],"cap":null,"pop":625,"title":"Pituffik","text":["Pituffik (meaning 'mooring place, place to tie something') is a former Inughuit settlement in North Star Bay, near Mount Dundas at the eastern end of Bylot Sound in northern Greenland. It was located on the plain that is now occupied by the runway of the U.S. Pituffik Space Base, formerly Thule Air Base. The Inughuit inhabitants were relocated to the present-day town of Qaanaaq. The relocation and the fallout from the 1968 Thule Air Base B-52 crash in the vicinity are a contentious issue in Greenland's relations with Denmark and the United States."]},{"k":4,"name":"Qeqqata","type":"Region","area":106183,"lab":[66.45,-47.75],"cap":"Sisimiut","pop":9423,"title":"Qeqqata","text":["Qeqqata (Greenlandic pronunciation: [qɜqːata], Danish: Centrum, lit. 'Centre') is a municipality in western Greenland, operational from 1 January 2009. The municipality was named after its location in the central-western part of the country. Its population is 9,179 as of January 2025. The administrative center of the municipality is in Sisimiut (formerly called Holsteinsborg)."]},{"k":5,"name":"Kujalleq","type":"Region","area":50573,"lab":[61.34,-44.47],"cap":"Qaqortoq","pop":6292,"title":"Kujalleq","text":["Kujalleq (Greenlandic: Greenlandic pronunciation: [kujaɬːɜq̚], Danish: Syden, lit. 'The South') is a municipality on the southern tip of Greenland, operational from 1 January 2009. The administrative center of the municipality is in Qaqortoq (formerly called Julianehåb)."]}]}